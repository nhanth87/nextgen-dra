<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>et.elisa</groupId>
  <artifactId>dra-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Elisa Nextgen DRA</name>

  <modules>
    <module>dra-core</module>
    <module>dra-ra</module>
    <module>dra-app</module>
    <module>bench</module>
    <module>lab/sas-diameter-testapp</module>
  </modules>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.version>3.37.3</quarkus.platform.version>
    <microjainslee.version>1.2.0-SNAPSHOT</microjainslee.version>
    <corsac.version>10.0.0-41-SNAPSHOT</corsac.version>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>et.elisa</groupId>
        <artifactId>dra-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.microjainslee</groupId>
        <artifactId>ra-diameter</artifactId>
        <version>${microjainslee.version}</version>
      </dependency>
      <dependency>
        <groupId>com.mobius-software.protocols.diameter</groupId>
        <artifactId>diameter-api</artifactId>
        <version>${corsac.version}</version>
      </dependency>
      <dependency>
        <groupId>com.mobius-software.protocols.diameter</groupId>
        <artifactId>diameter-impl</artifactId>
        <version>${corsac.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
